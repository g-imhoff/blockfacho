{
  "manifest_version": 3,
  "name": "Blockfacho",
  "version": "2.10",
  "description": "Bloque sur X, Instagram, TikTok, Facebook et YouTube les comptes de l'annuaire blockfacho, depuis tes sessions déjà connectées.",
  "permissions": ["scripting", "storage", "cookies"],
  "host_permissions": [
    "https://x.com/*",
    "https://onbloquelextremedroite.fun/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/*",
    "https://www.youtube.com/*"
  ],
  "action": { "default_title": "Blockfacho" },
  "background": { "service_worker": "background.js" }
}
